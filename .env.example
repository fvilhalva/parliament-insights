# Copy to .env and fill in. NEVER commit real secrets (NFR06).

# --- API (NestJS) ---
API_PORT=3000
NODE_ENV=development
# Internal boundary: API -> Agent orchestration
AGENT_BASE_URL=http://agent:8000

# --- Auth (FR08) ---
JWT_SECRET=change-me
API_KEY=change-me

# --- Database (Postgres + pgvector) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=parliament
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parliament_insights
DATABASE_URL=postgresql://parliament:change-me@db:5432/parliament_insights

# --- Redis (queue / cache) ---
REDIS_URL=redis://redis:6379

# --- LLM provider (NFR09: swap local <-> paid) ---
LLM_PROVIDER=ollama            # ollama | openai | anthropic
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Only when LLM_PROVIDER points to a paid API:
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
